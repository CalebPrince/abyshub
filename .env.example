# ─── Site ────────────────────────────────────────────────────────────────────
# Used to build the Paystack callback URL, so it must be the real public origin
# in production (e.g. https://abyshub.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Money ───────────────────────────────────────────────────────────────────
# Must be a currency your Paystack account is enabled for: NGN, GHS, ZAR, KES
# or USD. Change LOCALE to match (en-GH, en-ZA, en-KE …).
NEXT_PUBLIC_CURRENCY=GHS
NEXT_PUBLIC_LOCALE=en-GH

# Order thresholds, in MINOR units (pesewas).
# 50000 pesewas = GH₵500 · 3500 pesewas = GH₵35
NEXT_PUBLIC_FREE_DELIVERY_THRESHOLD=50000
NEXT_PUBLIC_DELIVERY_FLAT_RATE=3500

# ─── Paystack ────────────────────────────────────────────────────────────────
# Secret key is server-only — never prefix it with NEXT_PUBLIC_.
# Test keys start sk_test_ / pk_test_, live keys sk_live_ / pk_live_.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Contact ─────────────────────────────────────────────────────────────────
# WhatsApp number in international format, digits only, no + or spaces.
# Leave blank and every WhatsApp option disappears from the UI.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=orders@abyshub.com
