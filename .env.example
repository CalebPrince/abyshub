# ─── Site ────────────────────────────────────────────────────────────────────
# Used to build the Paystack callback URL and the links in account confirmation
# and password-reset emails, so it must be the real public origin in production
# (e.g. https://abyshub.com).
#
# Supabase has to be told the same origin, or it quietly substitutes its own:
# Authentication → URL Configuration → set Site URL to the origin below and add
# <origin>/auth/callback to Redirect URLs. A link arriving at "/?code=…" rather
# than "/auth/callback?code=…" is that substitution happening.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Money ───────────────────────────────────────────────────────────────────
# Must be a currency your Paystack account is enabled for: NGN, GHS, ZAR, KES
# or USD. Change LOCALE to match (en-GH, en-ZA, en-KE …).
NEXT_PUBLIC_CURRENCY=GHS
NEXT_PUBLIC_LOCALE=en-GH

# Order thresholds, in MINOR units (pesewas).
# 100000 pesewas = GH₵1,000 · 3500 pesewas = GH₵35
NEXT_PUBLIC_FREE_DELIVERY_THRESHOLD=100000
NEXT_PUBLIC_DELIVERY_FLAT_RATE=3500

# ─── Paystack ────────────────────────────────────────────────────────────────
# Secret key is server-only — never prefix it with NEXT_PUBLIC_.
# Test keys start sk_test_ / pk_test_, live keys sk_live_ / pk_live_.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Contact ─────────────────────────────────────────────────────────────────
# WhatsApp number in international format, digits only, no + or spaces.
# Leave blank and every WhatsApp option disappears from the UI.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=orders@abyshub.com

# ─── Resend order notifications ─────────────────────────────────────────────
# The sender must use a domain verified in your Resend account.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Abys Hub <orders@abyshub.com>

# ─── Legal pages ─────────────────────────────────────────────────────────────
# Shown on /legal/terms, /legal/privacy and /legal/cookies. Blank fields are
# left out of the page rather than printed empty — but fill the registered name
# and address in before you trade.
NEXT_PUBLIC_LEGAL_ENTITY=Abys Hub
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_REGISTRATION=
NEXT_PUBLIC_JURISDICTION=Ghana

# ─── Supabase / CRM ──────────────────────────────────────────────────────────
# Create a project at supabase.com, then run
# supabase/migrations/20260824000000_crm_foundation.sql in its SQL editor.
#
# Project Settings → API.
#
# Supabase renamed these keys. Newer projects show "Publishable" and "Secret"
# where older ones showed "anon" and "service_role"; they are the same two
# roles, and these variable names keep the older wording:
#
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  <- Publishable key  (sb_publishable_...)
#   SUPABASE_SERVICE_ROLE_KEY      <- Secret key       (sb_secret_...)
#
# The URL and the publishable key are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses row level security entirely — server-side only, never
# NEXT_PUBLIC_. Treat it like a database password: if it leaks, rotate it.
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs, for Mimi on WhatsApp and the website voice. All three are
# fallbacks only — the same keys in admin settings take precedence, and setting
# them there avoids a rebuild.
# The shared secret you invent, pasted into the agent webhook config. The tool
# webhook may carry it as ?secret=... instead, because ElevenLabs does not
# reliably send custom headers on tool calls.
ELEVENLABS_WEBHOOK_SECRET=
# Generated by ElevenLabs when you add the post-call webhook, shown once,
# begins wsec_. That webhook is HMAC-signed rather than sent with a header, so
# without this no WhatsApp transcript is ever stored.
ELEVENLABS_POSTCALL_SIGNING_SECRET=
# Speaks Mimi's replies on the website, and reads the agent back on the
# settings page. Needs text-to-speech plus read access to Agents.
ELEVENLABS_API_KEY=

# Who owns the shop. Mimi compares these against the WhatsApp caller ID so she
# knows when she is speaking to the owner rather than a customer; the numbers
# themselves never enter a prompt. Admin settings take precedence over these.
OWNER_NAME=
OWNER_WHATSAPP=
OWNER_PHONE=
